# Create this key in UniFi Site Manager: unifi.ui.com → API → Create API Key
UNIFI_API_KEY=

# Local dashboard
PORT=8787

# Starting poll interval. The Settings page saves over this value.
POLL_SECONDS=60

# A problem counts as repeated after this many consecutive checks
REPEAT_THRESHOLD=2

# WAN packet loss at or above this percent, for REPEAT_THRESHOLD checks, is a warning
PACKET_LOSS_PERCENT=2
